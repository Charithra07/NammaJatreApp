rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Events: Anyone can read (to see schedule), but only authorized (simulated as anyone signed in for now) can write
    // In a real app, we might have an admin role
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    // Items (Lost & Found): Anyone can read, signed in can create/delete their own or mark resolved
    match /items/{itemId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() 
        && isValidId(itemId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'active'
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        // Action: Resolve
        (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'resolved')
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Markers: Anyone can read
    match /markers/{markerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
